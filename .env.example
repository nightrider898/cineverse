# ---------------------------------------------------------------------------
# BookMyEvent environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Frontend (public, baked into the browser bundle: no secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=BookMyEvent
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Backend ---
# dev = demo data + mock payments; prod = neither
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/cineverse
DATABASE_USERNAME=cineverse
DATABASE_PASSWORD=cineverse

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P14D
QR_SIGNING_SECRET=change-me-too
# true in production (HTTPS)
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Demo accounts (dev profile only): demo@ / admin@ / staff@ / partner@cineverse.com
DEMO_USER_PASSWORD=Demo@12345

# --- Payments --------------------------------------------------------------
# Real gateways. Test-mode keys work immediately; live keys need an activated (KYC-verified) account.
# Routing: Card -> Stripe; UPI / Google Pay / PhonePe app / Net banking / Wallets -> Razorpay.
# (If only Razorpay is configured, cards go through Razorpay too.)
# Keep the mock gateway OFF once real keys are in, or it may be offered as a fallback.
PAYMENTS_MOCK_ENABLED=false
# Stripe: dashboard.stripe.com > Developers > API keys (sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8080/api/v1/payments/webhook/stripe` (whsec_...), optional locally
STRIPE_WEBHOOK_SECRET=
# Razorpay: dashboard.razorpay.com > Account & Settings > API keys (Test mode: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you add a webhook (needs a public URL, e.g. via ngrok) -> /api/v1/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# SANDBOX | PRODUCTION
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- Email -----------------------------------------------------------------
# console = nothing is sent; each email is saved as an .html preview in backend/email-outbox/
# smtp    = real email. Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USERNAME=you@gmail.com,
#           EMAIL_PASSWORD=<16-letter app password from myaccount.google.com/apppasswords>, EMAIL_FROM must be that Gmail address.
EMAIL_PROVIDER=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=BookMyEvent <no-reply@bookmyevent.example>
# Email a "new sign-in" notice on every login
EMAIL_LOGIN_ALERTS=true

# Company details used in email headers/footers
BRAND_NAME=BookMyEvent
BRAND_LEGAL_NAME=BookMyEvent Entertainment Pvt. Ltd.
BRAND_MOTTO=Every seat tells a story.
BRAND_SUPPORT_EMAIL=support@bookmyevent.in
BRAND_SUPPORT_PHONE=+91 40 4000 1234
BRAND_ADDRESS=Hitech City, Hyderabad, Telangana 500081
BRAND_INSTAGRAM_URL=https://www.instagram.com/
BRAND_X_URL=https://x.com/
BRAND_FACEBOOK_URL=https://www.facebook.com/
BRAND_YOUTUBE_URL=https://www.youtube.com/
BRAND_LINKEDIN_URL=https://www.linkedin.com/

# --- Posters & trailers -----------------------------------------------------
# TMDB (free): themoviedb.org > Settings > API. Either the v3 "API Key" or the v4 "API Read Access Token".
# With it, the backend fills posters, backdrops, official YouTube trailers, runtimes and cast photos automatically.
TMDB_API_KEY=
# Optional fallback for trailers TMDB doesn't list: console.cloud.google.com > YouTube Data API v3 > API key
YOUTUBE_API_KEY=
MEDIA_SYNC_ON_STARTUP=true

# Business policy (optional overrides)
SEAT_LOCK_DURATION=PT5M
CANCELLATION_CUTOFF_MINUTES=120
CONVENIENCE_FEE_PER_TICKET=25
TAX_RATE_ON_FEE=0.18

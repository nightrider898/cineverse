# Public (browser-visible) settings only. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=BookMyEvent
# Optional CDN/base for poster & backdrop paths returned by the API (defaults to this app's /public)
NEXT_PUBLIC_MEDIA_BASE_URL=
# Server-side URL for SSR metadata fetches (e.g. http://backend:8080 inside docker compose)
API_INTERNAL_URL=http://localhost:8080
# Footer (optional)
NEXT_PUBLIC_BRAND_MOTTO=Every seat tells a story.
NEXT_PUBLIC_SUPPORT_EMAIL=support@bookmyevent.in
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_X_URL=https://x.com/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/
